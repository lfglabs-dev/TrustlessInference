    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@tanstack/react-query": "^5.96.2",
    "ai": "^6.0.145",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
